# Host size target: 2gb (default, Redis on, no OpenSearch) or search (~4 GB+).
SNEKL_TARGET=2gb

# Public hostnames (no scheme). Point DNS A/AAAA records at this machine.
AUTH_HOST=auth.example.com
HUB_HOST=hub.example.com
CONTENT_HOST=origin.example.com

# Let's Encrypt account email (ignored when using Caddyfile.internal).
ACME_EMAIL=admin@example.com

# Caddyfile or Caddyfile.internal
CADDYFILE=Caddyfile

# Image tag baked by `./snekl pack` (leave latest when building from this repo).
SNEKL_VERSION=latest

POSTGRES_USER=snekl
POSTGRES_PASSWORD=change-me-postgres

# 32+ character secrets. Generate with: openssl rand -base64 48
AUTH_SIGNING_KEY=change-me-auth-signing-key-min-32-chars
AUTH_ADMIN_SIGNING_KEY=change-me-auth-admin-signing-key-min-32
HUB_ADMIN_SIGNING_KEY=change-me-hub-admin-signing-key-min-32
CONTENT_JWT_KEY=change-me-content-jwt-key-min-32-chars

MINIO_ROOT_USER=snekl
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BUCKET=snekl-media

# Display names
AUTH_NAME="Snekl Auth"
HUB_NAME="Snekl Hub"
NODE_NAME=Snekl
NODE_DESCRIPTION="A federated forum node"

# Optional SMTP. If Smtp host is empty, Auth only logs mail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=noreply@example.com
# EMAIL_FROM_NAME=Snekl Auth

# OpenSearch URL is set by --target search (do not set on the 2gb target).
