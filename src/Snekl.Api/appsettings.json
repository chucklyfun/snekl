{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=snekl;Username=snekl;Password=snekl",
    "Redis": "localhost:6379",
    "OpenSearch": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Rules": [
      { "PathPrefix": "/api/admin/login", "Method": "POST", "Limit": 10, "WindowSeconds": 60 },
      { "PathPrefix": "/api/auth/login", "Method": "POST", "Limit": 20, "WindowSeconds": 60 },
      { "PathPrefix": "/api/auth/register", "Method": "POST", "Limit": 10, "WindowSeconds": 60 },
      { "PathPrefix": "/api/federation/inbox", "Method": "POST", "Limit": 120, "WindowSeconds": 60 },
      { "PathPrefix": "/api/posts", "Method": "POST", "Limit": 30, "WindowSeconds": 60 },
      { "PathPrefix": "/api/media", "Method": "POST", "Limit": 20, "WindowSeconds": 60 }
    ]
  },
  "ObjectStorage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "snekl",
    "SecretKey": "sneklsecret",
    "Bucket": "snekl-media",
    "ForcePathStyle": true,
    "MaxUploadBytes": 10485760
  },
  "Push": {
    "FcmServerKey": ""
  },
  "Jwt": {
    "Key": "snekl-dev-secret-key-change-in-production-min-32-chars",
    "Issuer": "snekl",
    "Audience": "snekl",
    "ExpiryDays": "7"
  },
  "AuthIssuers": [
    {
      "Name": "Snekl Auth Alpha",
      "IssuerUrl": "http://localhost:5100",
      "JwksUrl": "http://localhost:5100/.well-known/jwks.json"
    },
    {
      "Name": "Snekl Auth Beta",
      "IssuerUrl": "http://localhost:5101",
      "JwksUrl": "http://localhost:5101/.well-known/jwks.json"
    }
  ],
  "Node": {
    "Name": "Snekl Node",
    "BaseUrl": "http://localhost:5000",
    "Description": "A federated forum node"
  },
  "Federation": {
    "RequireSignatures": true
  },
  "OpenSearch": {
    "Index": "snekl-posts"
  },
  "Snekl": {
    "AllowHardDelete": true,
    "OwnershipReauthWindowSeconds": 300
  },
  "Admin": {
    "TokenExpiryHours": "8",
    "GrantOperatorsSuperUser": true
  }
}
