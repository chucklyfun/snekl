# Default host target: ~2 GB RAM. Redis on, OpenSearch off.
# Used by ./up.sh (default) and ./up.sh --target 2gb
SNEKL_TARGET=2gb
COMPOSE_PROFILES=

REDIS_MAXMEMORY=64mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_WORK_MEM=4MB

# Origin search uses Postgres ILIKE. Do not start OpenSearch.
OPENSEARCH_URL=
